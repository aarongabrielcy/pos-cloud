# Names and non-sensitive placeholders only. Never put real credentials in this file.
#
# Real development configuration lives OUTSIDE this repository, at:
#   ../config/pos-cloud/infrastructure.env
#   ../config/pos-cloud/api.env
#   ../config/pos-cloud/worker.env
#
# See README.md "Configuracion externa" for how these are wired into Docker Compose and local
# `pnpm start:dev` runs.

NODE_ENV=development
APP_NAME=pos-cloud-api
APP_PORT=5100

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=pos_cloud
DATABASE_USER=pos_cloud
DATABASE_PASSWORD=changeme

REDIS_HOST=localhost
REDIS_PORT=6380

LOG_LEVEL=info

# CLOUD-01C-A: admin authentication - apps/api only, apps/worker must never receive these (see
# docs/architecture/admin-authentication.md). AUTH_JWT_SECRET below is a placeholder ONLY - real
# values are generated locally into ../config/pos-cloud/api.env, never committed here.
AUTH_JWT_SECRET=changeme-at-least-32-characters-long
AUTH_JWT_ISSUER=pos-cloud
AUTH_JWT_AUDIENCE=pos-cloud-admin
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_REFRESH_COOKIE_NAME=pos_cloud_admin_refresh

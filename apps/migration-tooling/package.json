{
  "name": "@pos-cloud/migration-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "migration:generate composition root - the only place that knows every bounded context's real TypeORM persistence records, so it can never be a runtime dependency of apps/api or apps/worker.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pos-cloud/config": "workspace:*",
    "@pos-cloud/customer-management": "workspace:*",
    "@pos-cloud/database": "workspace:*",
    "@pos-cloud/installations": "workspace:*",
    "@pos-cloud/licensing": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  }
}

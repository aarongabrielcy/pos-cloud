{
  "name": "pos-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "POSPlatform Cloud Foundation - modular monolith backend (Control Plane, Payment Orchestrator, Premium Commerce Data Plane)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:architecture": "depcruise apps/*/src libs/*/src libs/control-plane/*/src --config .dependency-cruiser.cjs --output-type err",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:architecture && pnpm build",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:build": "docker compose -f ../infra/docker-compose.yml build",
    "infra:up": "docker compose -f ../infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f ../infra/docker-compose.yml down",
    "infra:ps": "docker compose -f ../infra/docker-compose.yml ps",
    "infra:logs:api": "docker compose -f ../infra/docker-compose.yml logs -f pos-cloud-api",
    "infra:logs:worker": "docker compose -f ../infra/docker-compose.yml logs -f pos-cloud-worker",
    "migration:create": "pnpm --filter @pos-cloud/database exec typeorm-ts-node-commonjs migration:create src/migrations/Migration",
    "migration:generate": "pnpm --filter @pos-cloud/migration-tooling exec typeorm-ts-node-commonjs migration:generate -d src/cli/typeorm-cli-data-source.ts ../../libs/database/src/migrations/Migration",
    "migration:show": "docker compose -f ../infra/docker-compose.yml run --rm --build pos-cloud-migration-show",
    "migration:run": "docker compose -f ../infra/docker-compose.yml run --rm --build pos-cloud-migrations",
    "migration:revert": "docker compose -f ../infra/docker-compose.yml run --rm --build pos-cloud-migration-revert",
    "migration:show:internal": "pnpm --filter @pos-cloud/database exec typeorm-ts-node-commonjs migration:show -d src/cli/typeorm-cli-data-source.ts",
    "migration:run:internal": "pnpm --filter @pos-cloud/database exec typeorm-ts-node-commonjs migration:run -d src/cli/typeorm-cli-data-source.ts",
    "migration:revert:internal": "pnpm --filter @pos-cloud/database exec typeorm-ts-node-commonjs migration:revert -d src/cli/typeorm-cli-data-source.ts",
    "admin:bootstrap": "docker compose -f ../infra/docker-compose.yml run --rm --build -e BOOTSTRAP_ADMIN_EMAIL -e BOOTSTRAP_ADMIN_DISPLAY_NAME -e BOOTSTRAP_ADMIN_PASSWORD pos-cloud-admin-bootstrap",
    "admin:bootstrap:internal": "pnpm --filter @pos-cloud/api exec ts-node -r reflect-metadata src/tooling/admin-bootstrap.main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
